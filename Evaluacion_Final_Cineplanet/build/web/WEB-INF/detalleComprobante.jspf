<%@page pageEncoding="UTF-8"%>
<c:if test="${not empty venta}"><section class="comprobante"><h2>Compra N.º <c:out value="${venta.idVenta}"/></h2><p><strong><c:out value="${venta.cliente}"/></strong></p><p><c:out value="${venta.sede}"/> · <c:out value="${venta.fechaVenta}"/></p><p>Pago: <c:out value="${venta.medioPago}"/> · Estado: <c:out value="${venta.estado}"/></p>
<h3>Entradas</h3><div class="tabla"><table><thead><tr><th>N.º entrada</th><th>Película</th><th>Fecha y hora</th><th>Sala</th><th>Butaca</th><th>Precio</th><th>Estado</th></tr></thead><tbody><c:forEach var="e" items="${venta.entradas}"><tr><td><c:out value="${e.idEntrada}"/></td><td><c:out value="${e.titulo}"/></td><td><c:out value="${e.fechaHora}"/></td><td><c:out value="${e.sala}"/></td><td><c:out value="${e.butaca}"/></td><td>S/ <c:out value="${e.precioPagado}"/></td><td><c:out value="${e.estado}"/></td></tr></c:forEach></tbody></table></div>
<h3>Dulcería</h3><div class="tabla"><table><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead><tbody><c:forEach var="d" items="${venta.detalles}"><tr><td><c:out value="${d.nombre}"/></td><td><c:out value="${d.cantidad}"/></td><td>S/ <c:out value="${d.precioUnit}"/></td><td>S/ <c:out value="${d.subtotal}"/></td></tr></c:forEach></tbody></table></div><p class="total">Total pagado S/ <c:out value="${venta.total}"/></p><button id="imprimir" type="button">Imprimir comprobante</button></section></c:if>
