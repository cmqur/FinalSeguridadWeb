<%@page pageEncoding="UTF-8"%>
<%@include file="WEB-INF/encabezado.jspf"%><h1>Tu carrito</h1>
<c:choose><c:when test="${sessionScope.carrito.vacio}"><p>Tu carrito está vacío. Elige una función o agrega productos de dulcería.</p><a class="boton" href="TiendaServlet">Ver cartelera</a></c:when><c:otherwise>
<h2>Entradas</h2><div class="tabla"><table><thead><tr><th>Película</th><th>Función</th><th>Butaca</th><th>Precio</th><th></th></tr></thead><tbody><c:forEach var="i" items="${sessionScope.carrito.entradas}"><tr><td><c:out value="${i.funcion.titulo}"/></td><td><c:out value="${i.funcion.fechaHora}"/></td><td><c:out value="${i.butaca}"/></td><td>S/ <c:out value="${i.funcion.precio}"/></td><td><form method="post" action="CarritoServlet"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="quitarEntrada"><input type="hidden" name="idFuncion" value="<c:out value='${i.funcion.idFuncion}'/>"><input type="hidden" name="butaca" value="<c:out value='${i.butaca}'/>"><button class="secundario" type="submit">Quitar</button></form></td></tr></c:forEach></tbody></table></div>
<h2>Dulcería</h2><div class="tabla"><table><thead><tr><th>Producto</th><th>Cantidad</th><th>Subtotal</th><th></th></tr></thead><tbody><c:forEach var="i" items="${sessionScope.carrito.productos}"><tr><td><c:out value="${i.producto.nombre}"/></td><td><c:out value="${i.cantidad}"/></td><td>S/ <c:out value="${i.subtotal}"/></td><td><form method="post" action="CarritoServlet"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="quitarProducto"><input type="hidden" name="idProducto" value="<c:out value='${i.producto.idProducto}'/>"><button class="secundario" type="submit">Quitar</button></form></td></tr></c:forEach></tbody></table></div>
<p class="total">Total referencial S/ <c:out value="${sessionScope.carrito.total}"/></p><p>El importe definitivo se calcula con los precios vigentes al pagar.</p><div class="acciones"><a class="boton" href="PagoServlet">Continuar al pago</a><a href="DulceriaServlet">Agregar dulcería</a><form method="post" action="CarritoServlet"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="vaciar"><button class="secundario" type="submit">Vaciar carrito</button></form></div>
</c:otherwise></c:choose><%@include file="WEB-INF/pie.jspf"%>
