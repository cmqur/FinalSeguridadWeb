<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<!DOCTYPE html>
<html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Cineplanet Tienda segura</title><link rel="stylesheet" href="recursos/estilos.css"><script src="recursos/app.js" defer></script></head>
<body><header><a class="marca" href="LoginServlet">cineplanet</a><span>Entradas y dulcería</span>
<nav>
<c:if test="${not empty sessionScope.cliente}"><a href="TiendaServlet">Cartelera</a><a href="DulceriaServlet">Dulcería</a><a href="CarritoServlet">Carrito</a><a href="MisEntradasServlet">Mis entradas</a><span class="nombre"><c:out value="${sessionScope.cliente.nombres}"/></span></c:if>
<c:if test="${not empty sessionScope.usuario}"><a href="panel.jsp">Panel</a><c:if test="${sessionScope.usuario.rol eq 'ADMIN'}"><a href="VentaServlet">Ventas</a><a href="AuditoriaServlet">Auditoría</a></c:if><span class="nombre"><c:out value="${sessionScope.usuario.nombre}"/></span></c:if>
<c:if test="${not empty sessionScope.cliente or not empty sessionScope.usuario}"><form method="post" action="LogoutServlet"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><button class="secundario" type="submit">Cerrar sesión</button></form></c:if>
</nav></header><main>
<c:if test="${not empty error}"><div class="alerta error" role="alert"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty mensaje}"><div class="alerta" role="status"><c:out value="${mensaje}"/></div></c:if>
