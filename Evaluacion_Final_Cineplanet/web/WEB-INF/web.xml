<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
    <session-config><session-timeout>15</session-timeout><cookie-config><http-only>true</http-only></cookie-config><tracking-mode>COOKIE</tracking-mode></session-config>
    <welcome-file-list><welcome-file>index.jsp</welcome-file></welcome-file-list>
    <error-page><error-code>404</error-code><location>/error.jsp</location></error-page>
    <error-page><error-code>403</error-code><location>/error.jsp</location></error-page>
    <error-page><error-code>500</error-code><location>/error.jsp</location></error-page>
    <error-page><exception-type>java.lang.Exception</exception-type><location>/error.jsp</location></error-page>
</web-app>
